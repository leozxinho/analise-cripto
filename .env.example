# ===========================================
# CONFIGURAÇÃO DO PROJETO - MEMECOIN ANALYZER
# ===========================================

# --- WhatsApp (CallMeBot) ---
# 1. Mande "I allow callmebot to send me messages" para +34 644 61 96 87 no WhatsApp
# 2. Eles respondem com sua apikey
CALLMEBOT_API_KEY=sua-api-key-aqui
MEU_WHATSAPP_NUMERO=5514997780712   # DDI + DDD + número, sem + ou espaços

# --- Cache ---
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=120

# --- APIs Externas (todas com camada gratuita) ---
# GoPlus Security NÃO precisa de chave para uso básico
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1

# DEX Screener NÃO precisa de chave
DEXSCREENER_API_URL=https://api.dexscreener.com/latest

# CoinGecko - chave Demo grátis (opcional, aumenta limite de requisições)
# Pegue em: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- App ---
APP_ENV=production
LOG_LEVEL=INFO
